#!/bin/sh
# Pre-push guard: run the Driller regression suite before any push.
# A failing suite (drifted pot/stack accounting, broken hand flow) blocks the push.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:  git push --no-verify

# Resolve repo root so the hook works regardless of where git invokes it.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# Skip cleanly if there's nothing to test (e.g. partial checkout).
if [ ! -f package.json ]; then
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-push: installing test dependencies (first run)…"
  npm install --silent || {
    echo "pre-push: npm install failed — fix it or push with --no-verify." >&2
    exit 1
  }
fi

echo "pre-push: running test suite (npm test)…"
if ! npm test --silent; then
  echo "" >&2
  echo "pre-push: ❌ tests failed — push blocked." >&2
  echo "Fix the failures, or bypass intentionally with: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: ✅ tests passed."
exit 0
